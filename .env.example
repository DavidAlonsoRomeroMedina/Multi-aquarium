VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Contraseña del panel oculto en /admin-secret-aquarium
VITE_ADMIN_PASSWORD=cambia-esta-clave

# Opcional: usa Firebase Auth en lugar de la clave simple
VITE_USE_FIREBASE_AUTH=false
VITE_ADMIN_EMAIL=

# Imágenes de cartas: Base64 (<1MB) o Imgur (>=1MB)
# Crea un Client-ID gratis en https://api.imgur.com/oauth2/addclient
VITE_IMGUR_CLIENT_ID=

# Las fotos de integrantes van en: public/imagenes/
# Los fondos de estilo van en: public/fondo/
